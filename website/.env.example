# Public URL of the deployed site: canonical links, sitemap, robots, llms.txt,
# structured data and social cards all use it. On Vercel it falls back to the
# project's production domain automatically, but setting it is safer.
NEXT_PUBLIC_SITE_URL=https://madminers.example.com

# Optional: ownership verification codes (only the code, not the whole tag).
# Google Search Console → Add property → URL prefix → HTML tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML meta tag.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
