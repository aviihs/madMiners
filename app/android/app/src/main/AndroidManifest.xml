<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Online play: talk to the game server (HTTPS + WebSocket). -->
    <uses-permission
        android:name="android.permission.INTERNET"/>
    <!-- Know whether the phone is online before trying to connect. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Find a game server on the same Wi-Fi: receive its broadcast (multicast lock, see MainActivity.kt). -->
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission
        android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Haptic feedback on digs, hits and explosions (can be turned off in Settings). -->
    <uses-permission
        android:name="android.permission.VIBRATE"/>
    <!-- Touch screen game, landscape only. Wi-Fi is optional (mobile data works too). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true"/>
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="true"/>
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false"/>
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true"/>
    <application
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:label="Mad Miners"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:resizeableActivity="false"
            android:supportsPictureInPicture="false"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>